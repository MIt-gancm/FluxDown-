---
import { ArrowLeft } from "lucide-react";
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/site/PageHeader.astro";
import PricingVote from "@/components/pricing/vote/PricingVote";
import { langStaticPaths, resolveLang, href } from "@/i18n/routing";
import { pricingVote } from "@/i18n/messages/pricingVote";

export const getStaticPaths = langStaticPaths;
const lang = resolveLang(Astro.params.lang);
const t = pricingVote[lang];
// OAuth round-trips back to this page in the same language.
const returnTo = encodeURIComponent(href("/pricing/vote", lang));
---

<Layout lang={lang} title={t.meta.title} description={t.meta.description}>
  <PageHeader eyebrow={t.eyebrow} title={t.title} lede={t.lede}>
    <a class="btn btn-ghost" href={href("/pricing", lang)}>
      <ArrowLeft size={15} aria-hidden="true" />
      {t.back}
    </a>
    <a class="btn btn-ticks" href={href("/pricing/why", lang)}>{t.why}</a>
  </PageHeader>

  <div class="frame">
    <PricingVote
      client:load
      lang={lang}
      loginUrl={`/api/auth/github?returnTo=${returnTo}`}
      logoutUrl={`/api/auth/logout?returnTo=${returnTo}`}
    />
    <div class="rule"></div>
  </div>
</Layout>
