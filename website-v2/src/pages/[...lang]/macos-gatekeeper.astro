---
import Layout from "@/layouts/Layout.astro";
import PageHeader from "@/components/site/PageHeader.astro";
import TerminalBlock from "@/components/info/TerminalBlock.astro";
import { BrandIcon } from "@/components/icons/brand";
import { langStaticPaths, resolveLang, href } from "@/i18n/routing";
import { guides } from "@/i18n/messages/guides";

export const getStaticPaths = langStaticPaths;
const lang = resolveLang(Astro.params.lang);
const g = guides[lang];
const t = g.macos;
---

<Layout lang={lang} title={t.meta.title} description={t.meta.description}>
  <PageHeader eyebrow={t.eyebrow} title={t.title} lede={t.lede}>
    <a class="btn btn-primary" href={href("/download", lang)}>
      <BrandIcon name="apple" size={15} />
      {t.back}
    </a>
    <span class="chip mono num">{t.updated}</span>
  </PageHeader>

  <section class="frame">
    <div class="section-tight">
      <aside class="why" aria-labelledby="why-h">
        <span class="why-mark mono" aria-hidden="true">!</span>
        <div>
          <h2 id="why-h" class="text-[15px] font-semibold text-fg">{t.whyTitle}</h2>
          <p class="mt-2 max-w-[80ch] text-[14.5px] leading-relaxed text-muted">{t.whyDesc}</p>
        </div>
      </aside>
    </div>

    {
      t.methods.map((m, mi) => (
        <Fragment>
          <div class="rule" />
          <div class="section-tight method grid gap-8 lg:grid-cols-[300px_minmax(0,1fr)] lg:gap-16">
            <header class="method-head">
              <span class="eyebrow">{t.methodLabel(mi + 1)}</span>
              <h2 class="h3 mt-4">{m.title}</h2>
              <span class:list={["chip mt-4", mi === 0 && "chip-accent"]}>{m.tag}</span>
            </header>
            <ol class="steps">
              {m.steps.map((s, si) => (
                <li class="step" data-reveal style={`--d:${si}`}>
                  <span class="step-node mono num" aria-hidden="true">
                    {String(si + 1).padStart(2, "0")}
                  </span>
                  <div class="step-body">
                    <p class="step-text">{s.text}</p>
                    {s.code && <TerminalBlock code={s.code} labels={g.terminal} />}
                    {s.note && <p class="step-note">{s.note}</p>}
                  </div>
                </li>
              ))}
            </ol>
          </div>
        </Fragment>
      ))
    }

    <div class="rule"></div>
    <div class="cells grid md:grid-cols-[minmax(0,1fr)_auto]">
      <div class="cell">
        <p class="eyebrow">{t.tipTitle}</p>
        <p class="mt-3 max-w-[70ch] text-[15px] leading-relaxed text-muted">{t.tipDesc}</p>
      </div>
      <div class="cell flex flex-wrap items-center gap-3">
        <a class="btn btn-secondary" href={href("/feedback", lang)}>{t.feedback}</a>
        <a class="btn btn-ghost" href={href("/download", lang)}>
          <span aria-hidden="true">←</span>
          {t.back}
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .why {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 16px;
    padding: 18px 20px;
    border: 1px solid color-mix(in oklch, var(--warn) 40%, var(--line));
    border-left-width: 2px;
    border-left-color: var(--warn);
    border-radius: var(--radius);
    background: color-mix(in oklch, var(--warn) 6%, var(--bg-elev));
  }
  .why-mark {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 99px;
    font-size: 12px;
    font-weight: 600;
    color: var(--warn);
    box-shadow: 0 0 0 1px color-mix(in oklch, var(--warn) 55%, transparent) inset;
  }

  .method-head {
    align-self: start;
  }
  @media (min-width: 1024px) {
    .method-head {
      position: sticky;
      top: calc(var(--header-h) + 28px);
    }
  }
  .chip-accent {
    color: var(--accent-ink);
    background: var(--accent-soft);
    box-shadow: 0 0 0 1px var(--accent-line) inset;
  }

  /* 步骤:左侧编号节点串在一条 1px 竖轨上。 */
  .steps {
    display: grid;
    gap: 28px;
  }
  .step {
    position: relative;
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr);
    gap: 18px;
  }
  .step:not(:last-child)::before {
    content: "";
    position: absolute;
    left: 15.5px;
    top: 36px;
    bottom: -24px;
    width: 1px;
    background: repeating-linear-gradient(to bottom, var(--line-strong) 0 3px, transparent 3px 7px);
  }
  .step-node {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    font-size: 11.5px;
    color: var(--accent-ink);
    background: var(--bg-elev);
    box-shadow: 0 0 0 1px var(--line-strong) inset;
  }
  .step-body {
    display: grid;
    gap: 12px;
    min-width: 0;
    padding-top: 5px;
  }
  .step-text {
    font-size: 15px;
    line-height: 1.7;
    color: var(--fg);
  }
  .step-note {
    padding-left: 12px;
    border-left: 1px solid var(--line-strong);
    font-size: 13.5px;
    line-height: 1.65;
    color: var(--fg-muted);
  }
</style>
