---
/**
 * 终端命令块:mono 命令 + 复制按钮。复制逻辑是一段全局委托脚本(Astro 按模块去重,
 * 页面上多个块只注册一次);复制结果通过 aria-live 播报。
 */
interface Props {
  code: string;
  labels: { label: string; copy: string; copied: string; copyAria: string };
}
const { code, labels } = Astro.props;
---

<div class="term">
  <div class="term-bar">
    <span class="term-title" aria-hidden="true"><span class="term-dots"><i></i><i></i><i></i></span>{labels.label}</span>
    <button
      type="button"
      class="term-copy"
      data-copy={code}
      data-copied-label={labels.copied}
      aria-label={`${labels.copyAria}: ${code}`}
    >
      <svg class="i-copy" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"
        ><rect x="9" y="9" width="13" height="13" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg
      >
      <svg class="i-ok" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"
        ><path d="M20 6 9 17l-5-5"></path></svg
      >
      <span data-copy-label>{labels.copy}</span>
    </button>
  </div>
  <pre class="term-body"><span class="term-prompt" aria-hidden="true">$</span><code>{code}</code></pre>
  <span class="sr-only" aria-live="polite" data-copy-status></span>
</div>

<script>
  const timers = new WeakMap<HTMLElement, number>();
  document.addEventListener("click", async (event) => {
    const button = (event.target as Element | null)?.closest<HTMLButtonElement>("button[data-copy]");
    if (!button) return;
    const label = button.querySelector<HTMLElement>("[data-copy-label]");
    const status = button.closest(".term")?.querySelector<HTMLElement>("[data-copy-status]");
    try {
      await navigator.clipboard.writeText(button.dataset.copy ?? "");
    } catch {
      return;
    }
    if (label) {
      label.dataset.idle ??= label.textContent ?? "";
      label.textContent = button.dataset.copiedLabel ?? "";
    }
    if (status) status.textContent = button.dataset.copiedLabel ?? "";
    button.dataset.state = "copied";
    window.clearTimeout(timers.get(button));
    timers.set(
      button,
      window.setTimeout(() => {
        delete button.dataset.state;
        if (label) label.textContent = label.dataset.idle ?? "";
        if (status) status.textContent = "";
      }, 2000),
    );
  });
</script>

<style>
  .term {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-sunken);
    overflow: hidden;
  }
  .term-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    height: 36px;
    padding-inline: 12px 6px;
    border-bottom: 1px solid var(--line);
    background: var(--bg-elev);
  }
  .term-title {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-subtle);
  }
  .term-dots {
    display: inline-flex;
    gap: 5px;
  }
  .term-dots i {
    width: 7px;
    height: 7px;
    border-radius: 99px;
    box-shadow: 0 0 0 1px var(--line-strong) inset;
  }
  .term-copy {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 26px;
    padding-inline: 9px;
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--fg-muted);
    transition:
      color 160ms,
      background-color 160ms;
  }
  .term-copy:hover {
    color: var(--fg);
    background: var(--bg-inset);
  }
  .term-copy:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
  .term-copy .i-ok,
  .term-copy[data-state="copied"] .i-copy {
    display: none;
  }
  .term-copy[data-state="copied"] {
    color: var(--ok);
  }
  .term-copy[data-state="copied"] .i-ok {
    display: block;
  }
  .term-body {
    display: flex;
    gap: 12px;
    margin: 0;
    padding: 14px 16px;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.65;
    color: var(--fg);
    white-space: pre-wrap;
    word-break: break-all;
  }
  .term-prompt {
    color: var(--accent-ink);
    user-select: none;
  }
</style>
