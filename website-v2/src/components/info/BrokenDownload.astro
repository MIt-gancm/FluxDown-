---
/**
 * 404 图示:八段并行下载,七段依次填满,第 05 段停在半途并标记 404。
 * 纯 CSS 动画(一次性填充 + 断点处的呼吸标记);减弱动效时全局规则直接给出终态。
 */
interface Props {
  readout: string;
}
const { readout } = Astro.props;
const SEGMENTS = 8;
const BROKEN = 4;
---

<figure class="fig bd" aria-hidden="true">
  <div class="fig-bar"><span>fig. 404</span><span>segmented transfer</span></div>
  <ol class="segs">
    {
      Array.from({ length: SEGMENTS }, (_, i) => (
        <li class:list={["seg", i === BROKEN && "seg-broken"]} style={`--i:${i}`}>
          <span class="seg-id num">{String(i + 1).padStart(2, "0")}</span>
          <span class="seg-track">
            <span class="seg-fill" />
            {i === BROKEN && <span class="seg-break" />}
          </span>
          <span class="seg-state">{i === BROKEN ? "404" : "ok"}</span>
        </li>
      ))
    }
  </ol>
  <div class="bd-foot">
    <span class="num">7 / 8</span>
    <span class="bd-readout">{readout}</span>
  </div>
</figure>

<style>
  .bd {
    border-radius: var(--radius);
    overflow: hidden;
    font-family: var(--font-mono);
  }
  .segs {
    display: grid;
    gap: 10px;
    padding: 22px 20px;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 24px 24px;
    background-position: -1px -1px;
    background-color: var(--bg-sunken);
  }
  .seg {
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr) 30px;
    align-items: center;
    gap: 12px;
    font-size: 11px;
    color: var(--fg-subtle);
  }
  .seg-track {
    position: relative;
    height: 10px;
    border-radius: 2px;
    background: var(--bg-elev);
    box-shadow: 0 0 0 1px var(--line-strong) inset;
    overflow: hidden;
  }
  .seg-fill {
    position: absolute;
    inset: 0;
    background: var(--accent);
    transform-origin: left;
    transform: scaleX(0);
    animation: seg-fill calc(1300ms + var(--i) * 140ms) var(--ease-out) calc(var(--i) * 110ms) forwards;
  }
  .seg-state {
    text-align: right;
    opacity: 0;
    animation: seg-state 300ms ease calc(1300ms + var(--i) * 250ms) forwards;
  }
  @keyframes seg-fill {
    to {
      transform: scaleX(1);
    }
  }
  @keyframes seg-state {
    to {
      opacity: 1;
    }
  }

  /* 断裂段:填到 58% 后停住,剩余部分以斜线表示缺失,断点处一枚呼吸的十字标记。 */
  .seg-broken {
    color: var(--danger);
  }
  .seg-broken .seg-fill {
    background: var(--danger);
    animation-name: seg-stall;
  }
  @keyframes seg-stall {
    70% {
      transform: scaleX(0.58);
    }
    to {
      transform: scaleX(0.58);
    }
  }
  .seg-break {
    position: absolute;
    inset: 0 0 0 58%;
    background: repeating-linear-gradient(
      -45deg,
      color-mix(in oklch, var(--danger) 45%, transparent) 0 1px,
      transparent 1px 5px
    );
    border-left: 1px solid var(--danger);
    opacity: 0;
    animation:
      seg-state 300ms ease 1700ms forwards,
      seg-blink 1.6s ease-in-out 2000ms infinite;
  }
  .seg-broken .seg-state {
    font-weight: 600;
    animation-delay: 1800ms;
  }
  @keyframes seg-blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }

  .bd-foot {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 14px;
    border-top: 1px solid var(--line);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--fg-subtle);
  }
  .bd-readout {
    color: var(--danger);
    text-transform: uppercase;
    text-align: right;
  }
</style>
