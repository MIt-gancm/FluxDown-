---
/** 新版本邮件通知(POST /api/subscribe)+ 帮助链接。表单依赖 JS,无 JS 时 fieldset 保持禁用。 */
import { ArrowUpRight, ArrowRight, Bell } from "lucide-react";
import { download } from "@/i18n/messages/download";
import { href } from "@/i18n/routing";
import type { Lang } from "@/i18n/config";
import { GITHUB_URL } from "@/lib/site-nav";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = download[lang];
const platforms = Object.entries(t.subscribe.platforms) as [string, string][];
const help = [
  { label: t.help.gatekeeper, desc: t.help.gatekeeperDesc, href: href("/macos-gatekeeper", lang), external: false },
  { label: t.help.signing, desc: t.help.signingDesc, href: href("/code-signing", lang), external: false },
  { label: t.help.changelog, desc: t.help.changelogDesc, href: href("/changelog", lang), external: false },
  { label: t.help.releases, desc: t.help.releasesDesc, href: `${GITHUB_URL}/releases`, external: true },
];
---

<section class="frame" aria-labelledby="subscribe-title">
  <div class="cells split">
    <div class="flex flex-col gap-4 p-[clamp(24px,3.4vw,48px)]" id="subscribe">
      <span class="eyebrow">{t.subscribe.eyebrow}</span>
      <h2 id="subscribe-title" class="h3">{t.subscribe.title}</h2>
      <p class="max-w-[48ch] text-[14px] leading-relaxed text-muted">{t.subscribe.desc}</p>
      <form class="mt-2" data-subscribe novalidate>
        <fieldset class="form" disabled data-subscribe-fields>
          <label class="flex flex-col gap-1.5">
            <span class="eyebrow-plain">{t.subscribe.platform}</span>
            <select class="field" name="platform" data-subscribe-platform>
              {platforms.map(([value, label]) => <option value={value}>{label}</option>)}
            </select>
          </label>
          <label class="flex flex-col gap-1.5">
            <span class="eyebrow-plain">{t.subscribe.email}</span>
            <input
              class="field"
              type="email"
              name="email"
              required
              autocomplete="email"
              placeholder={t.subscribe.emailPlaceholder}
            />
          </label>
          <button type="submit" class="btn btn-primary self-end" data-subscribe-submit>
            <Bell size={15} strokeWidth={2} aria-hidden="true" />
            <span data-subscribe-label>{t.subscribe.submit}</span>
          </button>
        </fieldset>
        <p class="status" role="status" aria-live="polite" data-subscribe-status></p>
      </form>
    </div>
    <nav class="flex flex-col" aria-label={t.help.eyebrow}>
      <span class="eyebrow px-[clamp(24px,3.4vw,48px)] pt-[clamp(24px,3.4vw,48px)] pb-4">{t.help.eyebrow}</span>
      <ul class="help">
        {
          help.map((item) => (
            <li>
              <a
                href={item.href}
                class="help-link"
                target={item.external ? "_blank" : undefined}
                rel={item.external ? "noopener" : undefined}
              >
                <span class="flex flex-col gap-0.5">
                  <span class="text-[15px] font-medium text-fg">{item.label}</span>
                  <span class="text-[13px] text-muted">{item.desc}</span>
                </span>
                {item.external ? (
                  <ArrowUpRight size={16} strokeWidth={1.75} className="help-arrow" aria-hidden="true" />
                ) : (
                  <ArrowRight size={16} strokeWidth={1.75} className="help-arrow" aria-hidden="true" />
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</section>

<style>
  .split {
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 900px) {
    .split {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .form {
    display: grid;
    gap: 12px;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 560px) {
    .form {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr) auto;
      align-items: end;
    }
  }
  .form:disabled {
    opacity: 0.6;
  }
  .status {
    min-height: 1.5em;
    margin-top: 10px;
    font-size: 13px;
    color: var(--fg-muted);
  }
  .status[data-tone="ok"] {
    color: var(--ok);
  }
  .status[data-tone="error"] {
    color: var(--danger);
  }
  .help {
    border-top: 1px solid var(--line);
  }
  .help li + li {
    border-top: 1px solid var(--line);
  }
  .help-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px clamp(24px, 3.4vw, 48px);
    transition: background-color 160ms;
  }
  .help-link:hover {
    background: var(--bg-sunken);
  }
  .help-link :global(.help-arrow) {
    flex: none;
    color: var(--fg-subtle);
    transition: transform 200ms var(--ease-out), color 160ms;
  }
  .help-link:hover :global(.help-arrow) {
    color: var(--accent-ink);
    transform: translateX(2px);
  }
</style>
